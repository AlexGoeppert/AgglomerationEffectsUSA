select(Age, !!sym(model_col), !!sym(data_col)) %>%
rename(Model = !!sym(model_col), Data = !!sym(data_col)) %>%
mutate(
Age = factor(Age,
levels = c("00_05", "06_10", "11_15", "16_20", "21_25", "26_plus"),
