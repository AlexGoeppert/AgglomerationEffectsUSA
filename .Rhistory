## ========  QUARTERLY — GDP QoQ vs. DAX return (lagged 1 year)  ====== ##
gdp_q <- GDP_germany_quarterly %>%
mutate(date = as.Date(observation_date),
year = year(date),
quarter = quarter(date),
gdp_q_growth = 100 * (NGDPSAXDCDEQ / lag(NGDPSAXDCDEQ) - 1))
## ============================  PACKAGES  ============================ ##
library(dplyr)
library(lubridate)
library(lmtest)
library(sandwich)
## ========  QUARTERLY — GDP QoQ vs. DAX return (lagged 1 year)  ====== ##
gdp_q <- GDP_germany_quarterly %>%
mutate(date = as.Date(observation_date),
year = year(date),
quarter = quarter(date),
gdp_q_growth = 100 * (NGDPSAXDCDEQ / lag(NGDPSAXDCDEQ) - 1))
## ====================  QUARTERLY  (lag DAX 4 qtrs)  ================== ##
gdp_q <- GDP_germany_quarterly %>%
arrange(observation_date) %>%
mutate(date = as.Date(observation_date),
year = year(date),
quarter = quarter(date),
gdp_q_growth = 100 * (NGDPSAXDCDEQ / dplyr::lag(NGDPSAXDCDEQ) - 1))
dax_q <- DAX %>%
arrange(Date) %>%
mutate(date = as.Date(Date),
year = year(date),
quarter = quarter(date),
dax_q_ret      = 100 * (Close / dplyr::lag(Close) - 1),
dax_q_ret_lag4 = dplyr::lag(dax_q_ret, 4))
q_df <- inner_join(
gdp_q %>% select(year, quarter, gdp_q_growth),
dax_q %>% select(year, quarter, dax_q_ret_lag4),
by = c("year", "quarter")
) %>%
filter(year >= 1993, year <= 2022) %>%
na.omit()
mod_q <- lm(gdp_q_growth ~ dax_q_ret_lag4, data = q_df)
print(coeftest(mod_q, vcov = vcovHC(mod_q, type = "HC1")))
## ======================  YEARLY  (lag DAX 1 yr)  ===================== ##
gdp_y <- GDP_germany_year %>%
arrange(observation_date) %>%
mutate(year = year(as.Date(observation_date)),
gdp_y_growth = 100 * (NGDPXDCDEA / dplyr::lag(NGDPXDCDEA) - 1))
dax_y <- DAX %>%
arrange(Date) %>%
mutate(date = as.Date(Date),
year = year(date)) %>%
filter(month(date) == 12) %>%
mutate(dax_y_ret      = 100 * (Close / dplyr::lag(Close) - 1),
dax_y_ret_lag1 = dplyr::lag(dax_y_ret, 1))
y_df <- inner_join(
gdp_y %>% select(year, gdp_y_growth),
dax_y %>% select(year, dax_y_ret_lag1),
by = "year"
) %>%
filter(year >= 1993, year <= 2022) %>%
na.omit()
mod_y <- lm(gdp_y_growth ~ dax_y_ret_lag1, data = y_df)
print(coeftest(mod_y, vcov = vcovHC(mod_y, type = "HC1")))
########################  PACKAGES  ########################
library(dplyr)
library(lubridate)
library(lmtest)
library(sandwich)
###################  QUARTERLY REGRESSION  #################
gdp_q <- GDP_germany_quarterly %>%
arrange(observation_date) %>%
mutate(date         = as.Date(observation_date),
gdp_q_growth = 100 * (NGDPSAXDCDEQ / dplyr::lag(NGDPSAXDCDEQ) - 1),
year         = year(date),
quarter      = quarter(date))
dax_q <- DAX %>%
arrange(Date) %>%
mutate(date           = as.Date(Date),
dax_q_ret      = 100 * (Close / dplyr::lag(Close) - 1),
dax_q_ret_lag1 = dplyr::lag(dax_q_ret, 1),
year           = year(date),
quarter        = quarter(date))
df_q <- inner_join(
gdp_q %>% select(year, quarter, gdp_q_growth),
dax_q %>% select(year, quarter, dax_q_ret_lag1),
by = c("year", "quarter")
) %>%
na.omit()
mod_q <- lm(gdp_q_growth ~ dax_q_ret_lag1, data = df_q)
coeftest(mod_q, vcov = vcovHC(mod_q, type = "HC1"))
####################  YEARLY REGRESSION  ####################
gdp_y <- GDP_germany_year %>%
arrange(observation_date) %>%
mutate(year        = year(as.Date(observation_date)),
gdp_y_growth = 100 * (NGDPXDCDEA / dplyr::lag(NGDPXDCDEA) - 1))
dax_y <- DAX %>%
arrange(Date) %>%
mutate(date  = as.Date(Date),
year  = year(date)) %>%
filter(month(date) == 12) %>%                # keep 31-Dec rows
mutate(dax_y_ret      = 100 * (Close / dplyr::lag(Close) - 1),
dax_y_ret_lag1 = dplyr::lag(dax_y_ret, 1))
df_y <- inner_join(
gdp_y %>% select(year, gdp_y_growth),
dax_y %>% select(year, dax_y_ret_lag1),
by = "year"
) %>%
na.omit()
mod_y <- lm(gdp_y_growth ~ dax_y_ret_lag1, data = df_y)
coeftest(mod_y, vcov = vcovHC(mod_y, type = "HC1"))
gdp_q_growth
df_q
mod_q <- lm(gdp_q_growth ~ dax_q_ret_lag1, data = df_q)
mod_q
summary(mod_q)
summary(mod_y)
mod_q <- lm(gdp_q_growth ~ dax_q_ret_lag1, data = df_q)
mod_q
mod_q
summary(mod_q)
coeftest(mod_q, vcov = vcovHC(mod_q, type = "HC1"))
mod_y <- lm(gdp_y_growth ~ dax_y_ret_lag1, data = df_y)
mod_q <- lm(gdp_q_growth ~ dax_q_ret_lag1, data = df_q)
mod_q
mod_y
coeftest(mod_q, vcov = vcovHC(mod_q, type = "HC1"))
coeftest(mod_y, vcov = vcovHC(mod_y, type = "HC1"))
plot(df_q$dax_q_ret_lag1,df_q$gdp_q_growth)
plot(df_y$dax_y_ret_lag1,df_y$gdp_y_growth)
summary(mod_y)
plot(df_q$dax_q_ret_lag1,df_q$gdp_q_growth)
gdp_q
dax_q
plot(df_y$dax_y_ret_lag1,df_y$gdp_y_growth)
df_y
