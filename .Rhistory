)
# Calculate relative share for model
youngest_model <- country_data$Model[country_data$Age == "0-5"]
country_data <- country_data %>%
mutate(
Model_Relative = Model / youngest_model,
Data_Relative = Data  # Keep data as is
) %>%
select(-Model, -Data) %>%
pivot_longer(cols = c(Model_Relative, Data_Relative), names_to = "Source", values_to = "Value") %>%
mutate(Source = factor(Source, levels = c("Model_Relative", "Data_Relative"), labels = c("Model", "Data")))
# Calculate Y-axis Limit
y_max <- max(country_data$Value, na.rm = TRUE)
y_limit <- ceiling(y_max * 10) / 10  # Round up to the nearest 0.1
# Create the Plot
ggplot(country_data, aes(x = Age, y = Value, color = Source, group = Source)) +
geom_line(size = 1.5) +
geom_point(size = 4) +
scale_color_manual(
values = c("Model" = "darkred", "Data" = "darkblue"),
labels = c("Model", "Data"),
name = NULL
) +
scale_y_continuous(
limits = c(0, y_limit),
breaks = seq(0, y_limit, by = 0.2),
labels = scales::percent_format(accuracy = 1),  # Changed to percent format
expand = expansion(mult = c(0, 0.05))
) +
labs(
title = paste0("Share of Small Firms ", country),
x = "Firm Age (years)",
y = y_label
) +
theme_bw() +
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.position = "bottom",
plot.title = element_text(hjust = 0.5, face = "bold", size = 20),
plot.subtitle = element_text(hjust = 0.5, size = 16),
