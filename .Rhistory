# Function to Prepare Data and Create Plot
create_country_plot <- function(data, country) {
# Dynamically create column names based on the country
if (country == "India") {
data_col <- "IndiaShareEmp1FirmWithin"
model_col <- "India_Share"
y_label <- "Share of Small firms "
} else if (country == "USA") {
data_col <- "USAShareEmp1_4FirmWithin"
model_col <- "USA_Share"
y_label <- "Share of Small Firms"
}
# Prepare the Data
country_data <- data %>%
select(Age, !!sym(model_col), !!sym(data_col)) %>%
rename(Model = !!sym(model_col), Data = !!sym(data_col)) %>%
mutate(
Age = factor(Age,
levels = c("00_05", "06_10", "11_15", "16_20", "21_25", "26_plus"),
labels = c("0-5", "6-10", "11-15", "16-20", "21-25", "26+"))
)
# Calculate relative share for model
youngest_model <- country_data$Model[country_data$Age == "0-5"]
country_data <- country_data %>%
mutate(
Model_Relative = Model / youngest_model,
Data_Relative = Data  # Keep data as is
) %>%
select(-Model, -Data) %>%
pivot_longer(cols = c(Model_Relative, Data_Relative), names_to = "Source", values_to = "Value") %>%
mutate(Source = factor(Source, levels = c("Model_Relative", "Data_Relative"), labels = c("Model", "Data")))
# Calculate Y-axis Limit
y_max <- max(country_data$Value, na.rm = TRUE)
y_limit <- ceiling(y_max * 10) / 10  # Round up to the nearest 0.1
# Create the Plot
ggplot(country_data, aes(x = Age, y = Value, color = Source, group = Source)) +
geom_line(size = 1.5) +
geom_point(size = 4) +
scale_color_manual(
values = c("Model" = "darkred", "Data" = "darkblue"),
labels = c("Model (Relative to Age 0-5)", "Data"),
name = NULL
) +
scale_y_continuous(
limits = c(0, y_limit),
breaks = seq(0, y_limit, by = 0.2),
labels = scales::number_format(accuracy = 0.1),
expand = expansion(mult = c(0, 0.05))
) +
labs(
title = paste0("Share of Small Firms ", country),
x = "Firm Age (years)",
y = y_label
) +
theme_bw() +
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.position = "bottom",
plot.title = element_text(hjust = 0.5, face = "bold", size = 20),
plot.subtitle = element_text(hjust = 0.5, size = 16),
axis.title = element_text(size = 16, color = "black"),
axis.text = element_text(size = 14, color = "black"),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(margin = margin(r = 5)),
axis.ticks.length = unit(0.2, "cm"),
axis.ticks = element_line(size = 1, color = "black"),
axis.line = element_line(color = "black", size = 1),
legend.title = element_blank(),
legend.text = element_text(size = 14),
panel.border = element_blank(),
plot.background = element_blank(),
panel.background = element_blank(),
plot.margin = margin(b = 10, l = 10, t = 10, r = 10, unit = "pt")
) +
guides(color = guide_legend(title = NULL)) +
coord_cartesian(clip = "off")
}
