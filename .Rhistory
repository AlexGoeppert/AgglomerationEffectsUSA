# Dynamically create column names based on the country
if (country == "India") {
data_col <- "IndiaShareEmp1FirmWithin"
model_col <- "India_Share"
y_label <- "Share of Small firms"
} else if (country == "USA") {
data_col <- "USAShareEmp1_4FirmWithin"
